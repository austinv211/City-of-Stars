VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role key — used by scripts/parse-srd.mjs to populate SRD tables
# Get from: Supabase Dashboard → Settings → API → service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Session pooler URL — keep [YOUR-PASSWORD] as-is, set SUPABASE_DB_PASSWORD below
# (Supabase dashboard → Settings → Database → Connection string → Session mode)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-pooler.supabase.com:5432/postgres
# Raw database password (special characters are fine — the Makefile encodes it)
SUPABASE_DB_PASSWORD=your-database-password
