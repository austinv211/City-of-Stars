VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role key — used by scripts/parse-srd.mjs to populate SRD tables
# Get from: Supabase Dashboard → Settings → API → service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── db-push / db-push-dry ─────────────────────────────────────────────────────
# Session pooler URL — keep [YOUR-PASSWORD] as a literal, dev.ps1 substitutes it
# at runtime from SUPABASE_DB_PASSWORD (special characters are handled automatically).
# Get from: Supabase Dashboard → Settings → Database → Connection string → Session mode
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
# Raw database password
# Get from: Supabase Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password
