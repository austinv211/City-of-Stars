# ─────────────────────────────────────────────────────────────────────────────
# Local test stack. COMMITTED ON PURPOSE.
#
# These are the well-known keys that every `supabase start` instance publishes.
# They are not secrets: they only ever unlock a throwaway database on
# 127.0.0.1. Keeping them here (rather than in .env) is what lets the test
# jobs reference ZERO GitHub secrets — see the plan's §2.1.
#
# Verify/refresh with:  npx supabase status -o env
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Deterministic dice for E2E — makes @3d-dice/dice-box stand aside.
VITE_DICE_MODE=deterministic
