{
  "name": "cityofstars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:srd": "tsx scripts/check-srd-consistency.ts",
    "guard": "node --env-file=.env.e2e scripts/assert-not-production.mjs",
    "db:reset": "npm run guard && supabase db reset",
    "e2e:up": "supabase start && npm run db:reset",
    "e2e:down": "supabase stop",
    "test": "vitest run --project unit --project component",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "e2e:users": "node --env-file=.env.e2e scripts/seed-test-users.mjs",
    "verify:responsive": "node --env-file=.env.e2e scripts/verify-responsive.mjs",
    "lint": "eslint . --max-warnings 920",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . -f json -o lint-report.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "knip:strict": "knip --no-progress --include files,dependencies,unlisted,unresolved",
    "dup": "jscpd src/frontend --min-lines 10 --min-tokens 70 --threshold 1.7",
    "types:coverage": "type-coverage --at-least 99.7",
    "quality": "npm run lint && npm test && npx tsc --noEmit && npm run knip:strict && npm run types:coverage && npm run dup",
    "tauri:dev": "cd src/tauri && tauri dev",
    "tauri:build": "cd src/tauri && tauri build",
    "tauri:android:init": "cd src/tauri && tauri android init",
    "tauri:android:dev": "cd src/tauri && tauri android dev",
    "tauri:android:build": "cd src/tauri && tauri android build",
    "tauri": "cd src/tauri && tauri"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "^2.45.0",
    "@tauri-apps/api": "^2.0.0",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.99.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "type-coverage": "^2.30.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
