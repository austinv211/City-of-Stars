{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "City of Stars",
  "version": "0.9.0",
  "identifier": "com.cityofstars.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "City of Stars",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMzc1NTZERDFGN0Q2RgpSV1J2ZlIvZFZuVURCZm1mNVhMd1lFK1pQS1ZQaFJMaWpzMmI3Qnc0ZlA5a01IcVVmaERURXNGUAo=",
      "endpoints": [
        "https://github.com/austinv211/City-of-Stars/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cityofstars"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "cityofstars"
          ],
          "appLink": false
        }
      ]
    }
  }
}
